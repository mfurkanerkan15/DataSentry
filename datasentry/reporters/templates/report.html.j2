<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DataSentry Kalite Raporu - {{ report.file_name }}</title>
  <style>
    :root {
      --bg-body: #f8fafc;
      --bg-card: #ffffff;
      --bg-card-alt: #f1f5f9;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --color-pass: #10b981;
      --color-pass-bg: #ecfdf5;
      --color-warn: #f59e0b;
      --color-warn-bg: #fffbeb;
      --color-fail: #ef4444;
      --color-fail-bg: #fef2f2;
      --color-info: #0284c7;
      --color-info-bg: #f0f9ff;
      --color-brand: #2563eb;
      --radius: 10px;
      --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg-body: #0b1120;
        --bg-card: #1e293b;
        --bg-card-alt: #0f172a;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --border-color: #334155;
        --color-pass: #34d399;
        --color-pass-bg: rgba(16, 185, 129, 0.15);
        --color-warn: #fbbf24;
        --color-warn-bg: rgba(245, 158, 11, 0.15);
        --color-fail: #f87171;
        --color-fail-bg: rgba(239, 68, 68, 0.15);
        --color-info: #38bdf8;
        --color-info-bg: rgba(2, 132, 199, 0.15);
        --color-brand: #3b82f6;
        --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.4);
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.5;
      padding: 2rem 1rem;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
    }

    header {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow);
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 0.75rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--color-brand);
      letter-spacing: -0.025em;
    }

    .version-tag {
      background: var(--bg-card-alt);
      color: var(--text-muted);
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.2rem 0.5rem;
      border-radius: 6px;
      border: 1px solid var(--border-color);
    }

    .meta-list {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .meta-item strong {
      color: var(--text-main);
    }

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .kpi-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      padding: 1.25rem 1rem;
      text-align: center;
      box-shadow: var(--shadow);
    }

    .kpi-label {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
    }

    .kpi-value {
      font-size: 1.6rem;
      font-weight: 700;
    }

    .score-pass { color: var(--color-pass); }
    .score-warn { color: var(--color-warn); }
    .score-fail { color: var(--color-fail); }

    .badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.65rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .badge-passed {
      background-color: var(--color-pass-bg);
      color: var(--color-pass);
      border: 1px solid var(--color-pass);
    }

    .badge-warning {
      background-color: var(--color-warn-bg);
      color: var(--color-warn);
      border: 1px solid var(--color-warn);
    }

    .badge-failed {
      background-color: var(--color-fail-bg);
      color: var(--color-fail);
      border: 1px solid var(--color-fail);
    }

    .badge-info {
      background-color: var(--color-info-bg);
      color: var(--color-info);
      border: 1px solid var(--color-info);
    }

    .badge-error {
      background-color: var(--color-fail-bg);
      color: var(--color-fail);
      border: 1px solid var(--color-fail);
    }

    .section-title {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 1.5rem 0 1rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .checks-container {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .check-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .check-header {
      padding: 1rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      background: var(--bg-card);
    }

    .check-info {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .check-name {
      font-size: 1rem;
      font-weight: 600;
    }

    .check-desc {
      font-size: 0.825rem;
      color: var(--text-muted);
    }

    .check-status-area {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .affected-count {
      font-size: 0.85rem;
      font-weight: 600;
    }

    details {
      border-top: 1px solid var(--border-color);
      background: var(--bg-card-alt);
    }

    summary {
      padding: 0.75rem 1.25rem;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      user-select: none;
      outline: none;
    }

    summary:hover {
      color: var(--text-main);
    }

    .issues-content {
      padding: 0.75rem 1.25rem 1.25rem 1.25rem;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
      text-align: left;
    }

    th {
      background: var(--bg-card);
      color: var(--text-muted);
      font-weight: 600;
      padding: 0.6rem 0.75rem;
      border-bottom: 2px solid var(--border-color);
    }

    td {
      padding: 0.6rem 0.75rem;
      border-bottom: 1px solid var(--border-color);
      vertical-align: top;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .rows-tag {
      display: inline-block;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.75rem;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 0.15rem 0.4rem;
      color: var(--color-info);
      word-break: break-all;
    }

    .sample-tag {
      display: inline-block;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.75rem;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 0.15rem 0.4rem;
      color: var(--text-muted);
      margin: 0.1rem;
    }

    footer {
      text-align: center;
      margin-top: 2.5rem;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header>
      <div class="header-top">
        <div class="brand">
          <span class="brand-title">DataSentry</span>
          <span class="version-tag">v{{ datasentry_version }}</span>
        </div>
        <div>
          {% if report.is_valid %}
            {% if report.total_warnings > 0 %}
              <span class="badge badge-warning">UYARILAR VAR</span>
            {% else %}
              <span class="badge badge-passed">GEÇERLİ (BAŞARILI)</span>
            {% endif %}
          {% else %}
            <span class="badge badge-failed">GEÇERSİZ (HATALI)</span>
          {% endif %}
        </div>
      </div>
      <div class="meta-list">
        <div class="meta-item">Dosya: <strong>{{ display_path }}</strong></div>
        <div class="meta-item">Tarih: <strong>{{ report.timestamp.strftime('%Y-%m-%d %H:%M:%S UTC') }}</strong></div>
        <div class="meta-item">Analiz Süresi: <strong>{{ report.execution_time_ms }} ms</strong></div>
      </div>
    </header>

    <!-- KPI Grid -->
    <section class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-label">Kalite Skoru</div>
        <div class="kpi-value {{ quality_score_class }}">
          %{{ "%.2f"|format(report.quality_score) }}
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Toplam Satır</div>
        <div class="kpi-value">{{ report.total_rows }}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Toplam Sütun</div>
        <div class="kpi-value">{{ report.total_columns }}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Dosya Boyutu</div>
        <div class="kpi-value" style="font-size: 1.3rem;">{{ report.file_size_human }}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Kritik Hata</div>
        <div class="kpi-value {% if report.total_errors > 0 %}score-fail{% else %}score-pass{% endif %}">
          {{ report.total_errors }}
        </div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Uyarı</div>
        <div class="kpi-value {% if report.total_warnings > 0 %}score-warn{% else %}score-pass{% endif %}">
          {{ report.total_warnings }}
        </div>
      </div>
    </section>

    <!-- Kontroller -->
    <h2 class="section-title">Kalite Kontrolleri</h2>
    <div class="checks-container">
      {% for result in report.results %}
        <div class="check-card">
          <div class="check-header">
            <div class="check-info">
              <span class="check-name">{{ result.name }}</span>
              <span class="check-desc">{{ result.description }}</span>
            </div>
            <div class="check-status-area">
              <span class="affected-count {% if result.total_affected_rows > 0 %}score-fail{% else %}score-pass{% endif %}">
                {{ result.total_affected_rows }} kayıt etkilendi
              </span>
              {% if result.status.value == "PASSED" %}
                <span class="badge badge-passed">PASSED</span>
              {% elif result.status.value == "WARNING" %}
                <span class="badge badge-warning">WARNING</span>
              {% else %}
                <span class="badge badge-failed">FAILED</span>
              {% endif %}
            </div>
          </div>

          {% if result.issues %}
            <details {% if result.has_errors %}open{% endif %}>
              <summary>Bulguları İncele ({{ result.issues|length }} bulgu)</summary>
              <div class="issues-content">
                <table>
                  <thead>
                    <tr>
                      <th style="width: 80px;">Önem</th>
                      <th style="width: 120px;">Sütun</th>
                      <th>Açıklama</th>
                      <th style="width: 110px; text-align: right;">Etkilenen</th>
                      <th>Satırlar (Excel)</th>
                      <th>Örnek Değerler</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for issue in result.issues %}
                      <tr>
                        <td>
                          {% if issue.severity.value == "ERROR" %}
                            <span class="badge badge-error">ERROR</span>
                          {% elif issue.severity.value == "WARNING" %}
                            <span class="badge badge-warning">WARN</span>
                          {% else %}
                            <span class="badge badge-info">INFO</span>
                          {% endif %}
                        </td>
                        <td><strong>{{ issue.column if issue.column else "-" }}</strong></td>
                        <td>{{ issue.message }}</td>
                        <td style="text-align: right;">
                          {{ issue.count }}
                          {% if issue.percentage is not none %}
                            <br><small class="text-muted">(%{{ "%.2f"|format(issue.percentage) }})</small>
                          {% endif %}
                        </td>
                        <td>
                          {% if issue.row_numbers %}
                            <span class="rows-tag" title="{{ issue.row_numbers|join(', ') }}">
                              {% if issue.row_numbers|length <= 6 %}
                                {{ issue.row_numbers|join(', ') }}
                              {% else %}
                                {{ issue.row_numbers[:6]|join(', ') }} ... (+{{ issue.row_numbers|length - 6 }})
                              {% endif %}
                            </span>
                          {% else %}
                            -
                          {% endif %}
                        </td>
                        <td>
                          {% if issue.sample_values %}
                            {% for val in issue.sample_values[:5] %}
                              <span class="sample-tag">{{ val }}</span>
                            {% endfor %}
                            {% if issue.sample_values|length > 5 %}
                              <small>+{{ issue.sample_values|length - 5 }} daha</small>
                            {% endif %}
                          {% else %}
                            -
                          {% endif %}
                        </td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </details>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <!-- Footer -->
    <footer>
      DataSentry v{{ datasentry_version }} &bull; Açık kaynak kodlu CSV Kalite Doğrulama Motoru &bull; Rapor zamanı: {{ report.timestamp.strftime('%Y-%m-%d %H:%M:%S UTC') }}
    </footer>
  </div>
</body>
</html>
